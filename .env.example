# Copy to .env and adjust paths for your machine

# MSI/MPI Excel handoff directory
MSI_MPI_HANDOFF_DIR=

# MPI Vault (staging) — file-based store for Phase 1
MPI_VAULT_DIR=data/vault/staging

# Pending approvals queue
MPI_VAULT_APPROVALS_PATH=data/vault/approvals.json

# Required for /api/vault/submit, approve, reject and /admin/vault
VAULT_ADMIN_TOKEN=change-me-staging-token
